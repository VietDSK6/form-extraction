# LLM provider
# For OpenAI direct:
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4o-mini-2024-07-18
#
# For OpenRouter (cheaper):
#   OPENAI_API_KEY=sk-or-v1-...
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini

# App
APP_ENV=development
LOG_LEVEL=INFO

# Direct Mini App demo mode. Restrict origins when the deployed origin is known.
ALLOW_PUBLIC_EXTRACTION=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Recommended production mode when a trusted backend proxy is available.
# INTERNAL_API_KEY=your-internal-key-here
